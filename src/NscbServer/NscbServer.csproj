<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows desktop (WinForms+WebView2) on the -windows TFM; plain net10.0 builds the macOS/Linux
         single-file server (UI opens in the system browser). -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Serve wwwroot from embedded resources → single self-contained executable (no side-by-side wwwroot). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Windows-only desktop host: WinForms + WebView2, no-console GUI, icon, manifest. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Safety: ensure the WINDOWS symbol is defined for the native-host code, regardless of SDK defaults. -->
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- macOS / Linux: headless single-file server (console subsystem); the UI opens in the browser. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NscbCore\NscbCore.csproj" />
    <ProjectReference Include="..\NscbJobs\NscbJobs.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Do not copy wwwroot next to the exe (it is embedded below). -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="NscbServer.wwwroot.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control assembly on all net5.0+ apps, but this host uses
       WinForms only; Microsoft.Web.WebView2.Wpf.dll drags WindowsBase 5.0 → benign MSB3277. Drop it. -->
  <Target Name="DropUnusedWebView2WpfReference" Condition="'$(TargetFramework)' == 'net10.0-windows'" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
