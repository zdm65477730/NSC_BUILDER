<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet configuration for the nscb-web solution.
  Purpose: on machines where nuget.org is slow/unreachable, `dotnet build/test/publish` used to hang on
  "Determining projects to restore…" because restore tried to contact api.nuget.org. All three package
  dependencies (LibHac, ZstdSharp.Port, Microsoft.Web.WebView2 — plus xunit for tests) are already present
  in the global packages cache, so clearing the package sources makes restore resolve fully offline: fast,
  and it fails immediately (instead of hanging) if something is genuinely missing.

  To ADD or UPGRADE a package later, either temporarily re-enable a source below, or use a reachable mirror,
  e.g.:  <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
