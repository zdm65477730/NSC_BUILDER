# Default: store LF in the repo, hand out native line endings on checkout
# unless a rule below overrides it.
* text=auto

# Source / text — normalize.
*.cs text
*.slnx text

# Windows scripts: always CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts: always LF (they run under bash on Linux/macOS and Git Bash).
*.sh text eol=lf

# Truly binary — never rewrite.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Switch container/media samples (if ever present): binary.
*.nsp binary
*.nsz binary
*.xci binary
*.xcz binary
*.nca binary
*.ncz binary
