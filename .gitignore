# ── .NET build outputs (regenerable) ──────────────────────────────
bin/
obj/
.vs/
*.user
*.suo

# ── publish / delivery artifacts ──────────────────────────────────
dist/

# ── test scratch & logs ───────────────────────────────────────────
itest_out/
_verify_out/
nohup.out
*.log
*.tmp
*.orig
*.rej

# ── OS / editor junk ──────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ── Switch sample / media files: never commit ─────────────────────
*.nsp
*.nsz
*.nsx
*.xci
*.xcz
*.nca
*.ncz
*.zip
*.7z
*.rar
*.lnk
*.pdf

# NOTE: there is intentionally NO global '*.cs' rule here — this repo is
# C# source and every *.cs file must be tracked.
